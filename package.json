{
  "name": "wa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor de grupos do WhatsApp — captura mensagens, participantes e reações em JSONL local",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx tests/run.ts",
    "list-groups": "tsx src/scripts/list-groups.ts",
    "compact": "tsx src/scripts/compact.ts",
    "mongo:import": "tsx src/scripts/import-jsonl.ts",
    "mongo:build": "tsx src/scripts/build-metrics.ts",
    "mongo:migrate": "tsx src/scripts/migrate-groups.ts",
    "mongo:size": "tsx src/scripts/mongo-size.ts",
    "probe-polls": "tsx src/scripts/probe-polls.ts",
    "probe-reads": "tsx src/scripts/probe-reads.ts",
    "probe-history": "tsx src/scripts/probe-history.ts",
    "mongo:fix-members": "tsx src/scripts/mongo-fix-members.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@open-wa/wa-automate": "4.76.0",
    "dotenv": "^16.4.7",
    "mongodb": "^7.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
