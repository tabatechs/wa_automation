# Copie para .env e ajuste. O .env NÃO é versionado.

# Identificador da sessão. Define o nome do arquivo de credenciais em data/session/.
SESSION_ID=wa-monitor

# true  = sem janela do navegador; o QR sai no terminal (padrão, igual ao CLI).
# false = abre a janela — útil só para depurar o que a página faz.
HEADLESS=true

# User-agent enviado ao WhatsApp Web. Vazio = um UA de Chrome comum, definido
# em src/session.ts. NÃO use um UA com prefixo "WhatsApp/": o WA Web rejeita e
# devolve a página enganosa de "atualize o Chrome".
# USER_AGENT=

# --- Escape hatches de navegador (normalmente não precisa mexer) ---
# O Chromium que o puppeteer baixa junto já basta; não é preciso ter Chrome.
# true = usa o Google Chrome instalado no sistema.
USE_CHROME=false
# Caminho explícito de um executável de navegador.
# CHROME_PATH=

# Onde os eventos normalizados são gravados (JSON Lines, append-only).
EVENTS_FILE=data/events.jsonl

# Rotaciona o arquivo de eventos ao passar deste tamanho (bytes). Default 50 MB.
EVENTS_MAX_BYTES=52428800

# --- Coletor de reações (polling + diff) ---
# Intervalo entre varreduras, em ms.
REACTION_POLL_MS=30000
# Quantas mensagens recentes por grupo permanecem na janela de rastreio.
REACTION_WINDOW_SIZE=200
# Idade máxima, em horas, de uma mensagem na janela de rastreio.
REACTION_WINDOW_HOURS=48

# TTL do cache de nomes/números dos participantes, em ms. Default 15 min.
ROSTER_TTL_MS=900000

# --- Backfill do histórico ---
# No boot, recupera o que aconteceu antes do monitor subir.
BACKFILL_ENABLED=true
# Janela em dias usada no PRIMEIRO contato com um grupo. Depois disso o
# checkpoint assume e só o que é novo desde a última execução é lido.
BACKFILL_DAYS=7
# Teto de segurança para não paginar indefinidamente num grupo muito ativo.
BACKFILL_MAX_MESSAGES=5000

# debug | info | warn | error
LOG_LEVEL=info
