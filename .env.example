# Copie para .env e ajuste. O .env NÃO é versionado.

# Identificador da sessão. Define o nome do arquivo de credenciais em data/session/.
SESSION_ID=wa-monitor

# true  = sem janela do navegador; o QR sai no terminal (padrão, igual ao CLI).
# false = abre a janela — útil só para depurar o que a página faz.
HEADLESS=true

# User-agent enviado ao WhatsApp Web. Vazio = um UA de Chrome comum, definido
# em src/session.ts. NÃO use um UA com prefixo "WhatsApp/": o WA Web rejeita e
# devolve a página enganosa de "atualize o Chrome".
# USER_AGENT=

# --- Escape hatches de navegador (normalmente não precisa mexer) ---
# O Chromium que o puppeteer baixa junto já basta; não é preciso ter Chrome.
# true = usa o Google Chrome instalado no sistema.
USE_CHROME=false
# Caminho explícito de um executável de navegador.
# CHROME_PATH=

# Onde os eventos normalizados são gravados (JSON Lines, append-only).
EVENTS_FILE=data/events.jsonl

# Rotaciona o arquivo de eventos ao passar deste tamanho (bytes). Default 50 MB.
EVENTS_MAX_BYTES=52428800

# --- Coletor de reações (polling + diff) ---
# Intervalo entre varreduras, em ms.
REACTION_POLL_MS=30000
# Quantas mensagens recentes por grupo permanecem sob observação de reações.
REACTION_WINDOW_SIZE=2000
# Idade máxima, em horas, de uma mensagem sob observação. O valor efetivo nunca
# é menor que BACKFILL_DAYS: uma mensagem recuperada do histórico precisa ficar
# observada tempo suficiente para ter as reações lidas.
REACTION_WINDOW_HOURS=48

# TTL do cache de nomes/números dos participantes, em ms. Default 15 min.
ROSTER_TTL_MS=900000

# --- Confirmação de leitura das mensagens próprias ---
# Quem abriu as mensagens que VOCÊ enviou nos grupos monitorados. Só funciona
# para mensagens da própria conta: o WhatsApp não informa quem leu a mensagem
# de terceiros. Rode `npm run probe-reads` para conferir na sua sessão.
READ_RECEIPTS_ENABLED=true
# Intervalo entre varreduras, em ms. Mínimo 10000. Alto de propósito: o horário
# da leitura vem do WhatsApp, e o número de eventos é o mesmo em qualquer
# cadência — perguntar mais vezes só gasta consulta.
READ_RECEIPT_POLL_MS=900000
# Idade máxima, em horas, de uma mensagem própria ainda vigiada.
READ_RECEIPT_WINDOW_HOURS=48
# Teto de consultas por ciclo. Aqui o custo é por MENSAGEM (e não por grupo,
# como nas reações), então este número é o freio de mão.
READ_RECEIPT_MAX_PER_CYCLE=40

# --- Backfill do histórico ---
# No boot, recupera o que aconteceu antes do monitor subir.
BACKFILL_ENABLED=true
# Janela em dias usada no PRIMEIRO contato com um grupo. Depois disso o
# checkpoint assume e só o que é novo desde a última execução é lido.
BACKFILL_DAYS=7
# Teto de segurança para não paginar indefinidamente num grupo muito ativo.
BACKFILL_MAX_MESSAGES=5000

# --- MongoDB ---
# Destino das métricas de engajamento. Sem MONGODB_URI o monitor roda como
# antes, gravando só o JSONL — o Mongo é sempre opcional.
# A URI carrega usuário e senha: ela mora no .env, que NÃO é versionado.
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.exemplo.mongodb.net/?appName=app
MONGODB_DB=wa_monitor
MONGO_ENABLED=true

# Sufixo aplicado a TODAS as coleções: vazio grava em people/groups (produção),
# "_teste" grava em people_teste/groups_teste.
# Enquanto tiver valor, nenhuma escrita encosta nas coleções de produção.
# Esvazie a linha para valer.
MONGO_COLLECTION_SUFFIX=_teste

# Grava também o log bruto de eventos no Mongo (snapshots de grupo ficam de
# fora — eram o maior consumidor de espaço). Útil para recalcular métricas
# novas sem depender da máquina onde o JSONL está, mas custa ~45% do orçamento
# do plano gratuito do Atlas. Ver "Orçamento de espaço" no README.
MONGO_RAW_LOG=true
# 0 = nunca expira. 90 descarta automaticamente o log com mais de 90 dias
# (as métricas e as coleções de domínio continuam intactas).
MONGO_RAW_LOG_TTL_DAYS=0

# Agrupamento das escritas: descarrega a cada N ms ou a cada N eventos.
MONGO_FLUSH_MS=2000
MONGO_FLUSH_MAX=200

# Recálculo das métricas caras (percentis, concentração, tendências) dentro do
# monitor, em ms. 0 desliga — aí só roda com `npm run mongo:build`.
METRICS_REFRESH_MS=300000

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Whitelist dos grupos monitorados. SOMENTE o que estiver aqui é gravado em
# disco; qualquer outro grupo é descartado em memória.
#
# São ids do WhatsApp (sempre terminam em @g.us), separados por vírgula ou por
# quebra de linha — descubra os seus com `npm run list-groups`. Sem apelido: o
# nome do grupo é lido do WhatsApp na hora de puxar os dados. Um `#` no início
# da entrada desliga aquele grupo sem apagar o id.
#
# Fica aqui, e não num arquivo do repositório, porque id de grupo aponta para
# pessoas reais — este arquivo é o exemplo, o `.env` de verdade não é versionado.
# ---------------------------------------------------------------------------
MONITORED_GROUPS="120363000000000000@g.us,
120363000000000001@g.us"
